---
import MainLayout from '../layouts/MainLayout.astro';
import ImpleniBanner from '../components/ImpleniBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProblemSection from '../components/ProblemSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import MethodologySection from '../components/MethodologySection.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import TeamSection from '../components/TeamSection.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout
  title="Ahrens Optimate för Implenia | AI-Automatisering för Infrastrukturprojekt"
  description="Snabba, lokala AI-automatiseringar för infrastrukturprojekt. Prototyp på veckor, återbetalning på månader. Vi löser de dagliga processer som stora transformationsprogram inte når."
>
  <ImpleniBanner />
  <Header />

  <main id="main-content">
    <Hero />
    <ProblemSection />
    <ServicesSection />
    <MethodologySection />
    <SolutionsSection />
    <TeamSection />
    <PhilosophySection />
    <CTASection />
  </main>

  <Footer />
</MainLayout>
